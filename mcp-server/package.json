{
  "name": "clawskills-mcp",
  "version": "0.1.3",
  "description": "MCP server exposing ClawSkills API integration skill docs to AI agents",
  "type": "module",
  "bin": {
    "clawskills-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "prepack": "rm -rf ./skills && cp -r ../skills ./skills",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
